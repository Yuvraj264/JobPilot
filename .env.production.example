# JobPilot Production Environment Configuration Template
# Copy to .env in your production environment and fill in real values.

# Project Configuration
APP_NAME=JobPilot
APP_ENV=production
DEBUG=False
PORT=8000
CORS_ORIGINS=https://jobpilot.example.com

# PostgreSQL Database Configuration
POSTGRES_USER=jobpilot_prod_user
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=jobpilot_production
POSTGRES_HOST=postgres-service.internal
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobpilot_prod_user:YOUR_STRONG_POSTGRES_PASSWORD@postgres-service.internal:5432/jobpilot_production

# Storage Configuration
RESUME_STORAGE_PATH=/data/resumes
MAX_RESUME_FILE_SIZE_MB=10

# Playwright Browser Configuration
PLAYWRIGHT_HEADLESS=True
BROWSER_TIMEOUT_MS=30000

# AI Provider Credentials
AI_PROVIDER=openai
AI_API_KEY=YOUR_OPENAI_API_KEY
AI_MODEL_NAME=gpt-4o

# Security Parameters
API_RATE_LIMIT_PER_MINUTE=60
SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY_AT_LEAST_32_CHARS
ALLOWED_APPLICATION_DOMAINS=greenhouse.io,lever.co,jobvite.com

# Limits Enforcements
MAX_APPLICATIONS_PER_DAY=10
MAX_APPLICATIONS_PER_RUN=3
COOLDOWN_DAYS=30

# SSRF Protections
ALLOW_LOCAL_URLS_FOR_DEV=False
