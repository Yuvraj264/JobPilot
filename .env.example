# JobPilot Environment Configuration Example
# Copy to .env for local development

# Project Configuration
APP_NAME=JobPilot
APP_ENV=development
DEBUG=True
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev_password
POSTGRES_DB=jobpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Storage Configuration
RESUME_STORAGE_PATH=./storage/resumes
MAX_RESUME_FILE_SIZE_MB=10

# Database Connection URL for SQLAlchemy & Alembic
DATABASE_URL=postgresql://jobpilot:jobpilot_dev_password@localhost:5433/jobpilot_db
