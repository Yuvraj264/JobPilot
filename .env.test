# JobPilot Test Environment Configuration
APP_NAME=JobPilot_Test
APP_ENV=test
DEBUG=True
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=jobpilot_test
POSTGRES_PASSWORD=jobpilot_test_password
POSTGRES_DB=jobpilot_test_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=sqlite:///:memory:

# Storage
RESUME_STORAGE_PATH=./storage/test_resumes
MAX_RESUME_FILE_SIZE_MB=5

# Playwright Browser
PLAYWRIGHT_HEADLESS=True
BROWSER_TIMEOUT_MS=15000

# AI Provider
AI_PROVIDER=mock
AI_API_KEY=mock-test-key
AI_MODEL_NAME=gpt-4o-mock

# Security & Limits
API_RATE_LIMIT_PER_MINUTE=1000
SECRET_KEY=test-secret-key-32-characters-long!!!
ALLOWED_APPLICATION_DOMAINS=localhost,127.0.0.1,google.com

# Limits
MAX_APPLICATIONS_PER_DAY=10
MAX_APPLICATIONS_PER_RUN=3
COOLDOWN_DAYS=30
ALLOW_LOCAL_URLS_FOR_DEV=True
